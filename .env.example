# Google Cloud Console → Credentials. Restrict to "Places API (New)" only.
GOOGLE_PLACES_API_KEY=

# Apify → Settings → Integrations → API tokens (Personal token).
APIFY_TOKEN=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role. Server-side only. NEVER expose to client.
SUPABASE_SERVICE_KEY=
